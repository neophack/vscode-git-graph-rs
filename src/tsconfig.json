{
	// The extension host, as it ships: scripts/build/build.mjs bundles it for VS Code 1.38's
	// Node 10.11, which implements ES2018. Node API floors are ESLint's job (eslint-plugin-n);
	// `lib` here keeps newer ECMAScript builtins out. Colocated tests run on the dev Node and are
	// checked by the root tsconfig.json instead.
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"lib": [
			"es2018"
		],
		"target": "es2018",
		"module": "commonjs",
		"moduleResolution": "node",
		"types": [
			"node",
			"vscode"
		],
		// Emitted only by `npm run build:ts`, for the performance gates (test/perf/lib/env.mjs).
		"outDir": "../out",
		"sourceMap": true
	},
	"include": [
		"**/*.ts"
	],
	"exclude": [
		"webview",
		"**/*.test.ts"
	]
}
