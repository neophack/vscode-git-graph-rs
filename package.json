{
	"name": "git-graph-rs",
	"displayName": "%displayName%",
	"description": "%extension.description%",
	"version": "1.0.0",
	"license": "MIT",
	"private": true,
	"publisher": "neophack",
	"repository": {
		"type": "git",
		"url": "https://github.com/neophack/vscode-git-graph-rs.git"
	},
	"bugs": {
		"url": "https://github.com/neophack/vscode-git-graph-rs/issues"
	},
	"homepage": "https://github.com/neophack/vscode-git-graph-rs#readme",
	"engines": {
		"vscode": "^1.38.0",
		"node": ">=18"
	},
	"extensionKind": [
		"workspace"
	],
	"categories": [
		"Other"
	],
	"icon": "resources/icon.png",
	"activationEvents": [
		"onCommand:git-graph-rs.view",
		"onCommand:git-graph-rs.filterByFile",
		"onCommand:git-graph-rs.version",
		"onCommand:git-graph-rs.searchCommits",
		"workspaceContains:.git"
	],
	"main": "./out/extension.js",
	"scripts": {
		"build": "npm run build:native && npm run build:ts",
		"build:native": "node scripts/build-addon.mjs",
		"build:native:release": "node scripts/build-addon.mjs --release",
		"build:ts": "tsc -p tsconfig.json",
		"compile-src": "tsc -p ./src && node scripts/package-src.js",
		"compile-web": "tsc -p ./web && node scripts/package-web.js",
		"compile-web-debug": "tsc -p ./web && node scripts/package-web.js debug",
		"clean": "node scripts/clean.js",
		"compile": "npm run clean && npm run compile-src && npm run compile-web",
		"package": "vsce package --baseContentUrl https://example.invalid --baseImagesUrl https://example.invalid",
		"test": "npm run test:rust && npm run test:node",
		"test:rust": "cargo test --workspace",
		"test:node": "node scripts/run-tests.mjs",
		"bench": "node scripts/bench.mjs",
		"bench:all": "node scripts/bench.mjs --all",
		"analyze-log": "node scripts/analyze-log.mjs",
		"lint": "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all --check"
	},
	"dependencies": {
		"iconv-lite": "0.5.0"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.8.6",
		"@types/iconv-lite": "^0.0.1",
		"@types/node": "^8.10.66",
		"@types/vscode": "1.38.0",
		"@vscode/vsce": "^2.19.0",
		"sharp": "^0.35.3",
		"typescript": "^5.4.0",
		"uglify-js": "^3.19.3"
	},
	"contributes": {
		"commands": [
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.view",
				"title": "%command.git-graph-rs.view.title%",
				"icon": {
					"light": "resources/git-graph-rs-cmd-icon-light.svg",
					"dark": "resources/git-graph-rs-cmd-icon-dark.svg"
				}
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.addGitRepository",
				"title": "%command.git-graph-rs.addGitRepository.title%"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.clearAvatarCache",
				"title": "%command.git-graph-rs.clearAvatarCache.title%"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.endAllWorkspaceCodeReviews",
				"title": "%command.git-graph-rs.endAllWorkspaceCodeReviews.title%"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.endSpecificWorkspaceCodeReview",
				"title": "%command.git-graph-rs.endSpecificWorkspaceCodeReview.title%"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.fetch",
				"title": "%command.git-graph-rs.fetch.title%"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.removeGitRepository",
				"title": "%command.git-graph-rs.removeGitRepository.title%"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.resumeWorkspaceCodeReview",
				"title": "%command.git-graph-rs.resumeWorkspaceCodeReview.title%"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.version",
				"title": "%command.git-graph-rs.version.title%"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.searchCommits",
				"title": "%command.git-graph-rs.searchCommits.title%"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.filterByFile",
				"title": "%command.git-graph-rs.filterByFile.title%"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.openFile",
				"title": "%command.git-graph-rs.openFile.title%",
				"icon": "$(go-to-file)",
				"enablement": "isInDiffEditor && resourceScheme == git-graph-rs && git-graph-rs:codiconsSupported"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.amendLastCommit",
				"title": "%command.git-graph-rs.amendLastCommit.title%",
				"icon": "$(edit)"
			},
			{
				"category": "Git Graph RS",
				"command": "git-graph-rs.resetCurrentBranchToRemote",
				"title": "%command.git-graph-rs.resetCurrentBranchToRemote.title%",
				"icon": "$(discard)"
			}
		],
		"configuration": {
			"type": "object",
			"title": "%config.title%",
			"properties": {
				"git-graph-rs.commitDetailsView.autoCenter": {
					"type": "boolean",
					"default": true,
					"description": "%config.git-graph-rs.commitDetailsView.autoCenter.description%"
				},
				"git-graph-rs.commitDetailsView.fileView.fileTree.compactFolders": {
					"type": "boolean",
					"default": true,
					"description": "%config.git-graph-rs.commitDetailsView.fileView.fileTree.compactFolders.description%"
				},
				"git-graph-rs.commitDetailsView.fileView.type": {
					"type": "string",
					"enum": [
						"File Tree",
						"File List"
					],
					"enumDescriptions": [
						"%config.git-graph-rs.commitDetailsView.fileView.type.enumDescription0%",
						"%config.git-graph-rs.commitDetailsView.fileView.type.enumDescription1%"
					],
					"default": "File Tree",
					"description": "%config.git-graph-rs.commitDetailsView.fileView.type.description%"
				},
				"git-graph-rs.commitDetailsView.location": {
					"type": "string",
					"enum": [
						"Inline",
						"Docked to Bottom"
					],
					"enumDescriptions": [
						"%config.git-graph-rs.commitDetailsView.location.enumDescription0%",
						"%config.git-graph-rs.commitDetailsView.location.enumDescription1%"
					],
					"default": "Inline",
					"description": "%config.git-graph-rs.commitDetailsView.location.description%"
				},
				"git-graph-rs.contextMenuActionsVisibility": {
					"type": "object",
					"default": {},
					"properties": {
						"branch": {
							"type": "object",
							"properties": {
								"checkout": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.checkout.title%"
								},
								"rename": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.rename.title%"
								},
								"createBranch": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.createBranch.title%"
								},
								"delete": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.delete.title%"
								},
								"merge": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.merge.title%"
								},
								"rebase": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.rebase.title%"
								},
								"push": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.push.title%"
								},
								"pull": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.pull.title%"
								},
								"viewIssue": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.viewIssue.title%"
								},
								"createPullRequest": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.createPullRequest.title%"
								},
								"createArchive": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.createArchive.title%"
								},
								"selectInBranchesDropdown": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.selectInBranchesDropdown.title%"
								},
								"unselectInBranchesDropdown": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.unselectInBranchesDropdown.title%"
								},
								"copyName": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.branch.copyName.title%"
								}
							}
						},
						"commit": {
							"type": "object",
							"properties": {
								"addTag": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commit.addTag.title%"
								},
								"createBranch": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commit.createBranch.title%"
								},
								"checkout": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commit.checkout.title%"
								},
								"cherrypick": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commit.cherrypick.title%"
								},
								"revert": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commit.revert.title%"
								},
								"drop": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commit.drop.title%"
								},
								"merge": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commit.merge.title%"
								},
								"rebase": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commit.rebase.title%"
								},
								"reset": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commit.reset.title%"
								},
								"copyHash": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commit.copyHash.title%"
								},
								"copySubject": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commit.copySubject.title%"
								}
							}
						},
						"commitDetailsViewFile": {
							"type": "object",
							"properties": {
								"viewDiff": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commitDetailsViewFile.viewDiff.title%"
								},
								"viewFileAtThisRevision": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commitDetailsViewFile.viewFileAtThisRevision.title%"
								},
								"viewDiffWithWorkingFile": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commitDetailsViewFile.viewDiffWithWorkingFile.title%"
								},
								"openFile": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commitDetailsViewFile.openFile.title%"
								},
								"markAsReviewed": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commitDetailsViewFile.markAsReviewed.title%"
								},
								"markAsNotReviewed": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commitDetailsViewFile.markAsNotReviewed.title%"
								},
								"resetFileToThisRevision": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commitDetailsViewFile.resetFileToThisRevision.title%"
								},
								"copyAbsoluteFilePath": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commitDetailsViewFile.copyAbsoluteFilePath.title%"
								},
								"copyRelativeFilePath": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.commitDetailsViewFile.copyRelativeFilePath.title%"
								}
							}
						},
						"remoteBranch": {
							"type": "object",
							"properties": {
								"checkout": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.checkout.title%"
								},
								"delete": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.delete.title%"
								},
								"fetch": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.fetch.title%"
								},
								"merge": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.merge.title%"
								},
								"pull": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.pull.title%"
								},
								"createBranch": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.createBranch.title%"
								},
								"viewIssue": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.viewIssue.title%"
								},
								"createPullRequest": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.createPullRequest.title%"
								},
								"createArchive": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.createArchive.title%"
								},
								"selectInBranchesDropdown": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.selectInBranchesDropdown.title%"
								},
								"unselectInBranchesDropdown": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.unselectInBranchesDropdown.title%"
								},
								"copyName": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.remoteBranch.copyName.title%"
								}
							}
						},
						"stash": {
							"type": "object",
							"properties": {
								"apply": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.stash.apply.title%"
								},
								"createBranch": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.stash.createBranch.title%"
								},
								"pop": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.stash.pop.title%"
								},
								"drop": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.stash.drop.title%"
								},
								"copyName": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.stash.copyName.title%"
								},
								"copyHash": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.stash.copyHash.title%"
								}
							}
						},
						"tag": {
							"type": "object",
							"properties": {
								"viewDetails": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.tag.viewDetails.title%"
								},
