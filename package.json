						"Workspace Full Path"
					],
					"enumDescriptions": [
						"%config.git-graph-rs.repositoryDropdownOrder.enumDescription0%",
						"%config.git-graph-rs.repositoryDropdownOrder.enumDescription1%",
						"%config.git-graph-rs.repositoryDropdownOrder.enumDescription2%"
					],
					"default": "Workspace Full Path",
					"description": "%config.git-graph-rs.repositoryDropdownOrder.description%"
				},
				"git-graph-rs.retainContextWhenHidden": {
					"type": "boolean",
					"default": true,
					"description": "%config.git-graph-rs.retainContextWhenHidden.description%"
				},
				"git-graph-rs.showStatusBarItem": {
					"type": "boolean",
					"default": true,
					"description": "%config.git-graph-rs.showStatusBarItem.description%"
				},
				"git-graph-rs.sourceCodeProviderIntegrationLocation": {
					"type": "string",
					"enum": [
						"Inline",
						"More Actions"
					],
					"enumDescriptions": [
						"%config.git-graph-rs.sourceCodeProviderIntegrationLocation.enumDescription0%",
						"%config.git-graph-rs.sourceCodeProviderIntegrationLocation.enumDescription1%"
					],
					"default": "Inline",
					"description": "%config.git-graph-rs.sourceCodeProviderIntegrationLocation.description%"
				},
				"git-graph-rs.pullRequests.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%config.git-graph-rs.pullRequests.enabled.description%"
				},
				"git-graph-rs.stickyHeader": {
					"type": "boolean",
					"default": true,
					"description": "%config.git-graph-rs.stickyHeader.description%"
				},
				"git-graph-rs.tabIconColourTheme": {
					"type": "string",
					"enum": [
						"colour",
						"grey"
					],
					"enumDescriptions": [
						"%config.git-graph-rs.tabIconColourTheme.enumDescription0%",
						"%config.git-graph-rs.tabIconColourTheme.enumDescription1%"
					],
					"default": "colour",
					"description": "%config.git-graph-rs.tabIconColourTheme.description%"
				}
			}
		},
		"menus": {
			"commandPalette": [
				{
					"command": "git-graph-rs.openFile",
					"when": "isInDiffEditor && resourceScheme == git-graph-rs && git-graph-rs:codiconsSupported"
				},
				{
					"command": "git-graph-rs.filterByFile",
					"when": "false"
				}
			],
			"explorer/context": [
				{
					"command": "git-graph-rs.filterByFile",
					"when": "resourceScheme == file && !listMultiSelection",
					"group": "git-graph-rs@1"
				}
			],
			"editor/context": [
				{
					"command": "git-graph-rs.filterByFile",
					"when": "resourceScheme == file",
					"group": "git-graph-rs@1"
				}
			],
			"editor/title/context": [
				{
					"command": "git-graph-rs.filterByFile",
					"when": "resourceScheme == file",
					"group": "git-graph-rs@1"
				}
			],
			"scm/resourceState/context": [
				{
					"command": "git-graph-rs.filterByFile",
					"when": "!listMultiSelection",
					"group": "git-graph-rs@1"
				}
			],
			"editor/title": [
				{
					"command": "git-graph-rs.openFile",
					"group": "navigation",
					"when": "isInDiffEditor && resourceScheme == git-graph-rs && git-graph-rs:codiconsSupported"
				}
			],
			"scm/title": [
				{
					"when": "scmProvider == git && config.git-graph-rs.sourceCodeProviderIntegrationLocation == 'Inline'",
					"command": "git-graph-rs.view",
					"group": "navigation"
				},
				{
					"when": "scmProvider == git && config.git-graph-rs.sourceCodeProviderIntegrationLocation == 'More Actions'",
					"command": "git-graph-rs.view",
					"group": "inline"
				},
				{
					"when": "scmProvider == git",
					"command": "git-graph-rs.amendLastCommit",
					"group": "git-graph-rs@1"
				},
				{
					"when": "scmProvider == git",
					"command": "git-graph-rs.resetCurrentBranchToRemote",
					"group": "git-graph-rs@2"
				}
			]
		}
	}
}
