								}
							}
						},
						"uncommittedChanges": {
							"type": "object",
							"properties": {
								"stash": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.uncommittedChanges.stash.title%"
								},
								"reset": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.uncommittedChanges.reset.title%"
								},
								"clean": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.uncommittedChanges.clean.title%"
								},
								"openSourceControlView": {
									"type": "boolean",
									"title": "%config.git-graph-rs.contextMenuActionsVisibility.uncommittedChanges.openSourceControlView.title%"
								}
							}
						}
					},
					"markdownDescription": "%config.git-graph-rs.contextMenuActionsVisibility.markdownDescription%"
				},
				"git-graph-rs.customBranchGlobPatterns": {
					"type": "array",
					"items": {
						"type": "object",
						"title": "%config.git-graph-rs.customBranchGlobPatterns.items.title%",
						"required": [
							"name",
							"glob"
						],
						"properties": {
							"name": {
								"type": "string",
								"title": "%config.git-graph-rs.customBranchGlobPatterns.items.name.title%",
								"description": "%config.git-graph-rs.customBranchGlobPatterns.items.name.description%"
							},
							"glob": {
								"type": "string",
								"title": "%config.git-graph-rs.customBranchGlobPatterns.items.glob.title%",
								"description": "%config.git-graph-rs.customBranchGlobPatterns.items.glob.description%"
							}
						}
					},
					"default": [],
					"description": "%config.git-graph-rs.customBranchGlobPatterns.description%"
				},
				"git-graph-rs.customEmojiShortcodeMappings": {
					"type": "array",
					"items": {
						"type": "object",
						"title": "%config.git-graph-rs.customEmojiShortcodeMappings.items.title%",
						"required": [
							"shortcode",
							"emoji"
						],
						"properties": {
							"shortcode": {
								"type": "string",
								"title": "%config.git-graph-rs.customEmojiShortcodeMappings.items.shortcode.title%",
								"description": "%config.git-graph-rs.customEmojiShortcodeMappings.items.shortcode.description%"
							},
							"emoji": {
								"type": "string",
								"title": "%config.git-graph-rs.customEmojiShortcodeMappings.items.emoji.title%",
								"description": "%config.git-graph-rs.customEmojiShortcodeMappings.items.emoji.description%"
							}
						}
					},
					"default": [],
					"description": "%config.git-graph-rs.customEmojiShortcodeMappings.description%"
				},
				"git-graph-rs.customPullRequestProviders": {
					"type": "array",
					"items": {
						"type": "object",
						"title": "%config.git-graph-rs.customPullRequestProviders.items.title%",
						"required": [
							"name",
							"templateUrl"
						],
						"properties": {
							"name": {
								"type": "string",
								"title": "%config.git-graph-rs.customPullRequestProviders.items.name.title%",
								"description": "%config.git-graph-rs.customPullRequestProviders.items.name.description%"
							},
							"templateUrl": {
								"type": "string",
								"title": "%config.git-graph-rs.customPullRequestProviders.items.templateUrl.title%",
								"markdownDescription": "%config.git-graph-rs.customPullRequestProviders.items.templateUrl.markdownDescription%"
							}
						}
					},
					"default": [],
					"markdownDescription": "%config.git-graph-rs.customPullRequestProviders.markdownDescription%"
				},
				"git-graph-rs.avatars.gitlabToken": {
					"type": "string",
					"default": "",
					"description": "%config.git-graph-rs.avatars.gitlabToken.description%"
				},
				"git-graph-rs.date.format": {
					"type": "string",
					"enum": [
						"Date & Time",
						"Date Only",
						"ISO Date & Time",
						"ISO Date Only",
						"Relative"
					],
					"enumDescriptions": [
						"%config.git-graph-rs.date.format.enumDescription0%",
						"%config.git-graph-rs.date.format.enumDescription1%",
						"%config.git-graph-rs.date.format.enumDescription2%",
						"%config.git-graph-rs.date.format.enumDescription3%",
						"%config.git-graph-rs.date.format.enumDescription4%"
					],
					"default": "Date & Time",
					"description": "%config.git-graph-rs.date.format.description%"
				},
				"git-graph-rs.date.type": {
					"type": "string",
					"enum": [
						"Author Date",
						"Commit Date"
					],
					"enumDescriptions": [
						"%config.git-graph-rs.date.type.enumDescription0%",
						"%config.git-graph-rs.date.type.enumDescription1%"
					],
					"default": "Author Date",
					"description": "%config.git-graph-rs.date.type.description%"
				},
				"git-graph-rs.defaultColumnVisibility": {
					"type": "object",
					"properties": {
						"Date": {
							"type": "boolean",
							"title": "%config.git-graph-rs.defaultColumnVisibility.Date.title%"
						},
						"Author": {
							"type": "boolean",
							"title": "%config.git-graph-rs.defaultColumnVisibility.Author.title%"
						},
						"Commit": {
							"type": "boolean",
							"title": "%config.git-graph-rs.defaultColumnVisibility.Commit.title%"
						}
					},
					"default": {
						"Date": true,
						"Author": true,
						"Commit": true
					},
					"description": "%config.git-graph-rs.defaultColumnVisibility.description%"
				},
				"git-graph-rs.dialog.addTag.pushToRemote": {
					"type": "boolean",
					"default": false,
					"description": "%config.git-graph-rs.dialog.addTag.pushToRemote.description%"
				},
				"git-graph-rs.dialog.addTag.type": {
					"type": "string",
					"enum": [
						"Annotated",
						"Lightweight"
